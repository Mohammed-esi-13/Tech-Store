# Port the container listens on (docker-compose maps host 5000 -> 3000).
PORT=3000
NODE_ENV=development
# Comma-separated frontend origin(s) allowed by CORS, e.g. Vite dev server.
CORS_ORIGIN=http://localhost:5173
# Postgres connection string (used once the real DB layer lands).
DATABASE_URL=postgresql://user:password@localhost:5432/neotek_tech_store
